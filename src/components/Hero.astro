---
import { CurveDivider } from "@polinom-io/px-ds-react";

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <span class="eyebrow">{t("hero.eyebrow")}</span>
    <h1>{t("hero.h1")}</h1>
    <p class="dek">{t("hero.dek")}</p>

    <div class="equation">
      <span class="op">{t("hero.equation.prefix")}</span><span class="op"> = </span><span class="term">{t("hero.equation.strategy")}</span><span class="op">·x³ + </span><span class="term">{t("hero.equation.engineering")}</span><span class="op">·x² + </span><span class="term">{t("hero.equation.data")}</span><span class="op">·x + </span><span class="term">{t("hero.equation.execution")}</span>
    </div>

    <div class="cta-row">
      <a class="btn btn-primary" href="#contact">{t("hero.ctaPrimary")}</a>
      <a class="btn btn-ghost" href="#approach">{t("hero.ctaGhost")}</a>
    </div>
  </div>
</section>

<CurveDivider />
