---
import { otherLang } from "../i18n/ui";

interface Props {
  lang: string;
  t: (key: string) => string;
  /** Same page in the other language; defaults to the other language's home. */
  translationHref?: string;
}

const { lang, t, translationHref } = Astro.props;
const target = otherLang(lang);
const flags: Record<string, string> = { en: "🇺🇸", es: "🇪🇸" };

// Default locale ("en") lives at the site root; "es" lives under /es/.
const targetHref = translationHref ?? (target === "en" ? "/" : `/${target}/`);
const homeHref = lang === "en" ? "/" : `/${lang}/`;
// Section anchors must point at the home page so they work from any page.
const onHome = Astro.url.pathname === homeHref;
const sectionHref = (id: string): string => (onHome ? `#${id}` : `${homeHref}#${id}`);
---

<header class="site">
  <div class="wrap nav">
    <a href={homeHref} class="wordmark">polinom<sup>.io</sup></a>
    <nav class="links">
      <a href={sectionHref("approach")}>{t("nav.approach")}</a>
      <a href={sectionHref("services")}>{t("nav.services")}</a>
      <a href={sectionHref("process")}>{t("nav.process")}</a>
      <a href={sectionHref("contact")}>{t("nav.contact")}</a>
      <a href={lang === "en" ? "/blog/" : `/${lang}/blog/`}>{t("nav.blog")}</a>
    </nav>
    <div class="toggle-group">
      <a class="lang-toggle" href={targetHref} aria-label={t("lang.switchLabel")}>
        <span class="lang-flag" aria-hidden="true">{flags[target]}</span>{target.toUpperCase()}
      </a>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label={t("theme.toggleLabel")}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById("themeToggle");
  const KEY = "polinom-theme";
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  // Two states: follow the system (nothing stored) or an explicit override of the opposite scheme.
  const apply = (value: string | null) => {
    if (value === "light" || value === "dark") root.setAttribute("data-theme", value);
    else root.removeAttribute("data-theme");
  };

  toggle?.addEventListener("click", () => {
    const current = root.getAttribute("data-theme");
    const renderedDark = current ? current === "dark" : systemDark.matches;
    const target = renderedDark ? "light" : "dark";
    // Back to the system scheme: drop the override instead of pinning it.
    const stored = (target === "dark") === systemDark.matches ? null : target;
    apply(stored);
    try {
      if (stored) localStorage.setItem(KEY, stored);
      else localStorage.removeItem(KEY);
    } catch (e) {}
  });

  // Keep tabs in sync when the override changes elsewhere.
  window.addEventListener("storage", (event) => {
    if (event.key === KEY) apply(event.newValue);
  });
</script>
