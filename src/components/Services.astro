---
import { Card } from "@polinom-io/px-ds-react";
import { useDictionary } from "../i18n/ui";

interface Props {
  lang: string;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;
const terms = useDictionary(lang).services.terms;
---

<section class="alt" id="services">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t("services.eyebrow")}</span>
      <h2>{t("services.h2")}</h2>
      <p>{t("services.p")}</p>
    </div>
    <div class="terms-grid">
      {terms.map((term) => (
        <Card exponent={term.degree} title={term.title}>{term.body}</Card>
      ))}
    </div>
  </div>
</section>
