---
import { useDictionary } from "../i18n/ui";

interface Props {
  lang: string;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;
const terms = useDictionary(lang).services.terms;
---

<section class="alt" id="services">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t("services.eyebrow")}</span>
      <h2>{t("services.h2")}</h2>
      <p>{t("services.p")}</p>
    </div>
    <div class="terms-grid">
      {terms.map((term) => (
        <div class="term-card">
          <span class="degree">{term.degree}</span>
          <h3>{term.title}</h3>
          <p>{term.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
