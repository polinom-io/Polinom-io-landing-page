---
import "../styles/global.css";

interface Props {
  lang: string;
  title: string;
  description: string;
  /** False when this page has no counterpart in the other language: drops the hreflang alternates. */
  hasTranslation?: boolean;
}

const { lang, title, description, hasTranslation = true } = Astro.props;

// English lives at the root and Spanish under /es/ (prefixDefaultLocale: false).
const pathWithoutLocale = Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/";
const englishURL = new URL(pathWithoutLocale, Astro.site);
const spanishURL = new URL(`/es${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`, Astro.site);
const canonicalURL = lang === "es" ? spanishURL : englishURL;
const ogLocale = lang === "es" ? "es_CL" : "en_US";
const ogImageURL = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <!-- Apply a stored theme override before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      try {
        var stored = localStorage.getItem("polinom-theme");
        if (stored === "light" || stored === "dark") document.documentElement.setAttribute("data-theme", stored);
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {
      hasTranslation && (
        <>
          <link rel="alternate" hreflang="en" href={englishURL} />
          <link rel="alternate" hreflang="es" href={spanishURL} />
          <link rel="alternate" hreflang="x-default" href={englishURL} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Polinom.io" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts used above the fold; subset to Latin (see public/fonts/README.md). -->
    <link rel="preload" href="/fonts/px-xenon-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hack-regular.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
