---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { useTranslations } from "../../i18n/ui";
import { formatPostDate, getPublishedPosts, postSlug, type BlogPost } from "../../lib/blog-posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("en");
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = "en";
const t = useTranslations(lang);
const { Content } = await render(post);
---

<Layout lang={lang} title={`${post.data.title} — Polinom.io`} description={post.data.description} hasSpanishVersion={false}>
  <Header lang={lang} t={t} />
  <main id="top" class="wrap blog">
    <article class="blog-post">
      <a class="back-link" href="/blog/">{t("blog.backToBlog")}</a>
      <h1>{post.data.title}</h1>
      <time class="post-meta" datetime={post.data.pubDate.toISOString()}>
        {formatPostDate(post.data.pubDate, lang)}
      </time>
      <Content />
    </article>
  </main>
  <Footer lang={lang} t={t} />
</Layout>
